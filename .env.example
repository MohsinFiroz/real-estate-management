# Server Configuration
# The port your application will listen on.
# REQUIRED: Yes
SERVER_PORT=8080

# The logging level for your application (e.g., debug, info, warn, error).
# REQUIRED: No (default is 'info')
LOG_LEVEL=info

# Database Configuration
# Host where your PostgreSQL database is located.
# REQUIRED: Yes
DB_HOST=localhost

# Port for the PostgreSQL database.
# REQUIRED: Yes
DB_PORT=5432

# The username for connecting to your PostgreSQL database.
# REQUIRED: Yes
DB_USER=your_user

# The password for connecting to your PostgreSQL database.
# REQUIRED: Yes
DB_PASSWORD=your_password

# The name of your PostgreSQL database.
# REQUIRED: Yes
DB_NAME=real_estate_db

# SSL Mode for PostgreSQL connection (e.g., disable, require, verify-ca, verify-full).
# REQUIRED: No (default is 'disable')
DB_SSL_MODE=disable

# Additional configurations

# Environment (e.g., development, production).
# REQUIRED: No (default is 'development' if not specified)
# ENV=development

